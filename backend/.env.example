# Project environment configuration template
DATABASE_URL="postgresql://postgres:your-supabase-db-password@db.xxxxxx.supabase.co:5432/postgres"

# Supabase Auth JWT Secret (Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard"

# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Optional local AI models
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Transcription config (falls back to Gemini multimodal if True)
WHISPER_FALLBACK_TO_GEMINI="True"